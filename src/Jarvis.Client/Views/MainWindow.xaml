<Window x:Class="Jarvis.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Jarvis.Client.Views"
        Title="{Binding WindowTitle, FallbackValue=DevilDrive}"
        Icon="/Assets/vault.ico"
        Height="720" Width="1280" MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Margin="6,4,6,2">
            <ToolBar>
                <Button AutomationProperties.Name="Get Latest" Command="{Binding GetLatestCommand}"
                        ToolTip="Download the newest version of every file. Files you've changed are never overwritten.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource PrimaryToolGlyph}" Text="&#xE896;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Get Latest" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button AutomationProperties.Name="Check Out" Command="{Binding CheckOutCommand}"
                        ToolTip="Lock the selected files so only you can edit them, and make them writable.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource PrimaryToolGlyph}" Text="&#xE72E;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Check Out" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Check In" Command="{Binding CheckInCommand}"
                        ToolTip="Save the selected files to the vault as a new version (with nothing selected: everything you can check in).">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource PrimaryToolGlyph}" Text="&#xE898;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Check In" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Undo Check Out" Command="{Binding UndoCheckOutCommand}"
                        ToolTip="Throw away your changes to the selected files and release the check-out.">
                    <StackPanel MinWidth="80">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7A7;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Undo Check Out" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button AutomationProperties.Name="Review" Command="{Binding SubmitReviewCommand}" ToolTip="Ask an admin to review and release the selected files.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8FB;" Foreground="#0F766E" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Review" />
                    </StackPanel>
                </Button>                <Button AutomationProperties.Name="History" Command="{Binding HistoryCommand}" ToolTip="See every version of the selected file and restore an old one.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE81C;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="History" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Milestones" Command="{Binding MilestonesCommand}" ToolTip="Snapshots of the whole vault (e.g. design reviews): view the vault as it was.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7C1;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Milestones" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Return to Latest" Command="{Binding ReturnToLatestCommand}" Visibility="{Binding IsViewingMilestone, Converter={StaticResource BoolToVis}}"
                        ToolTip="Leave the milestone and go back to the newest files.">
                    <StackPanel MinWidth="80">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72B;" Foreground="#B45309" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Return to Latest" />
                    </StackPanel>
                </Button>                <Button AutomationProperties.Name="Refresh" Command="{Binding RefreshCommand}" ToolTip="Update the list and who has what checked out (F5).">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72C;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Refresh" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button AutomationProperties.Name="Open" Command="{Binding OpenCommand}" ToolTip="Open the selected file (SolidWorks opens it read-only unless it's checked out to you).">
                    <StackPanel MinWidth="50">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8E5;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Open" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Explorer" Command="{Binding ShowInExplorerCommand}" ToolTip="Show the selected file in Windows Explorer.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE838;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Explorer" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="McMaster" Command="{Binding AddMcMasterCommand}"
                        ToolTip="Add a McMaster-Carr part by its part number (goes in COTS\MCMASTER).">
                    <StackPanel MinWidth="64">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7BF;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="McMaster" />
                    </StackPanel>
                </Button>
                <Separator Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                <Button AutomationProperties.Name="Break Lock" Command="{Binding BreakLockCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: release someone else's stale check-out.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE711;" Foreground="#C62828" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Break Lock" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Update Vault Setup" Command="{Binding UpdateVaultSetupCommand}" Visibility="{Binding HasSetupProblems, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: install or repair the vault guard on GitHub and the vault's storage rules.">
                    <StackPanel MinWidth="90">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE83D;" Foreground="#B45309" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Update Vault Setup" />
                    </StackPanel>
                </Button>                <Button AutomationProperties.Name="Request Check-In" Command="{Binding RequestCheckInCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: have the person who has this file checked out check in their last saved version automatically.">
                    <StackPanel MinWidth="80">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE715;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Request Check-In" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Freeze" Command="{Binding FreezeCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: freeze the selected files (e.g. released for production) so nobody can change them.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xEA18;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Freeze" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Unfreeze" Command="{Binding UnfreezeCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: make the selected frozen files editable again.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE785;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Unfreeze" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button AutomationProperties.Name="Numbering" Command="{Binding NumberingCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: the vault's part-numbering convention (prefix, groups like 200 Turret). New parts get the next free number.">
                    <StackPanel MinWidth="66">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8EF;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Numbering" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Team" Command="{Binding TeamCommand}" ToolTip="Who has access to this vault. Admins add teammates (by GitHub username) or remove them here.">
                    <StackPanel MinWidth="56">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE716;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Team" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Settings" Command="{Binding SettingsCommand}" ToolTip="Vault folder and your GitHub username.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Settings" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Border DockPanel.Dock="Top" Background="{Binding BannerBrush}" Padding="14,9" Margin="12,0,12,8" CornerRadius="8"
                BorderBrush="{Binding BannerBorderBrush}" BorderThickness="1"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding BannerIcon}" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{Binding BannerIconBrush}" Margin="0,1,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding BannerText}" Foreground="{Binding BannerTextBrush}" TextWrapping="Wrap" LineHeight="20" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="12,4,12,10">
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="2,0,8,0" ToolTip="Vault" />
            <ComboBox Width="220" ItemsSource="{Binding Vaults}" SelectedItem="{Binding SelectedVault}" FontWeight="SemiBold"
                      ToolTip="Switch to another group's vault." />
            <Button Content="Vaults" Command="{Binding ManageVaultsCommand}" Margin="6,0,16,0"
                    ToolTip="Add another group's vault (from your GitHub repos) or remove one." />
            <ComboBox DockPanel.Dock="Right" Width="210" Margin="8,0,0,0" SelectedIndex="{Binding FilterIndex}">
                <ComboBoxItem Content="All files" />
                <ComboBoxItem Content="Checked out to me" />
                <ComboBoxItem Content="Checked out by others" />
                <ComboBoxItem Content="Needs attention" />
                <ComboBoxItem Content="Newer version in vault" />
                <ComboBoxItem Content="Frozen" />
                <ComboBoxItem Content="Not downloaded" />
                <ComboBoxItem Content="In review" />
                <ComboBoxItem Content="Delete requested" />
            </ComboBox>
            <Grid>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,5,8,5"
                         Tag="Search by name, part number, description or any property" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom" Margin="6,0,6,2">
            <StatusBarItem>
                <ProgressBar Width="80" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource FaintTextBrush}" Margin="10,0,0,0"
                           ToolTip="DevilDrive checks for a newer version each time it starts" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource MutedTextBrush}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12,0,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="140" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="320" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Folders: click one to see its files (and its subfolders' files); drag files onto one to move them there. -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0,6,0,4">
                <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" BorderThickness="0" Background="Transparent"
                          SelectedItemChanged="OnFolderSelected" AllowDrop="True" DragOver="OnFolderDragOver" Drop="OnFolderDrop"
                          PreviewMouseRightButtonDown="OnFolderRightClick">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2,3" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#D4A017"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource FaintTextBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New Folder&#x2026;" Command="{Binding NewFolderCommand}" />
                            <MenuItem Header="Show in Explorer" Command="{Binding ShowFolderInExplorerCommand}" />
                            <Separator />
                            <MenuItem Header="Delete Folder (empty only)" Command="{Binding DeleteFolderCommand}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0,2,0,0">
            <DataGrid x:Name="FilesGrid"
                      ItemsSource="{Binding FilesView}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      Margin="4,0,4,4"
                      SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnGridDoubleClick"
                      PreviewMouseLeftButtonDown="OnGridMouseDown"
                      PreviewMouseLeftButtonUp="OnGridMouseUp"
                      PreviewMouseMove="OnGridMouseMove">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Check Out" Command="{Binding CheckOutCommand}" />
                        <MenuItem Header="Check In&#x2026;" Command="{Binding CheckInCommand}" />
                        <MenuItem Header="Undo Check Out" Command="{Binding UndoCheckOutCommand}" />
                        <MenuItem Header="Delete Local File&#x2026;" Command="{Binding DeleteLocalCommand}"
                                  ToolTip="Delete files that were made on this PC and never checked in" />
                        <MenuItem Header="Export&#x2026;" Command="{Binding ExportCommand}"
                                  ToolTip="Copy the files and everything they use to a folder or .zip that opens on any PC (like Pack and Go)" />
                        <MenuItem Header="Rename&#x2026;" Command="{Binding RenameCommand}"
                                  ToolTip="Rename the file; assemblies and drawings that use it are updated and checked in with it" />
                        <MenuItem Header="Move to Folder&#x2026;" Command="{Binding MoveToFolderCommand}"
                                  ToolTip="Move the selected files to another folder (or drag them onto a folder on the left)" />
                        <MenuItem Header="Request Delete&#x2026;" Command="{Binding RequestDeleteCommand}"
                                  ToolTip="Ask the admins to delete the file from the vault for everyone, and say why" />
                        <MenuItem Header="Withdraw Delete Request" Command="{Binding WithdrawDeleteRequestCommand}" />
                        <MenuItem Header="Delete from Vault&#x2026; (admin)" Command="{Binding DeleteFromVaultCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Delete the file for everyone (it goes away at their next Get Latest)" />
                        <MenuItem Header="Reject Delete Request&#x2026; (admin)" Command="{Binding RejectDeleteRequestCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <Separator />
                        <MenuItem Header="Submit for Review&#x2026;" Command="{Binding SubmitReviewCommand}" />
                    <MenuItem Header="Withdraw from Review" Command="{Binding WithdrawReviewCommand}" />
                    <MenuItem Header="Approve &amp; Release&#x2026; (admin)" Command="{Binding ApproveReviewCommand}"
                              Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                    <MenuItem Header="Reject&#x2026; (admin)" Command="{Binding RejectReviewCommand}"
                              Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                    <Separator />                    <MenuItem Header="Download" Command="{Binding DownloadCommand}" />
                    <MenuItem Header="Return to Latest Version" Command="{Binding ReturnToLatestVersionCommand}" />
                    <MenuItem Header="Notify Me When It's Free (on/off)" Command="{Binding WatchCommand}" />
                    <MenuItem Header="History&#x2026;" Command="{Binding HistoryCommand}" />
                        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" />
                        <Separator Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Break Lock (admin)" Command="{Binding BreakLockCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Request Check-In&#x2026; (admin)" Command="{Binding RequestCheckInCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Freeze&#x2026; (admin)" Command="{Binding FreezeCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Unfreeze (admin)" Command="{Binding UnfreezeCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="32" CanUserResize="False" SortMemberPath="StateSort">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StateGlyph}" Foreground="{Binding StateBrush}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230" />
                    <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- No PartNumber property yet: the file name is shown, greyed out. -->
                                    <DataTrigger Binding="{Binding HasPartNumber}" Value="False">
                                        <Setter Property="Foreground" Value="#8A94A6" />
                                        <Setter Property="ToolTip" Value="No PartNumber property yet, showing the file name" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="170" />
                    <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="210" SortMemberPath="StateSort" />
                    <DataGridTextColumn Header="Checked Out By" Binding="{Binding CheckedOutBy}" Width="130" />
                    <DataGridTextColumn Header="Since" Binding="{Binding CheckedOutSince, StringFormat='{}{0:ddd MMM d, h:mm tt}'}" Width="130" />
                    <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" SortMemberPath="Version" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="Check-ins on this PC / in the vault" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBehind}" Value="True">
                                        <Setter Property="Foreground" Value="#C2410C" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="ToolTip" Value="The vault has newer check-ins. Click Get Latest." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Rev" Binding="{Binding RevisionText}" Width="52" />
                    <DataGridTextColumn Header="Last Check-In Comment" Binding="{Binding LastComment}" Width="260" />
                    <DataGridTextColumn Header="Checked In By" Binding="{Binding LastCheckedInBy}" Width="120" />
                    <DataGridTextColumn Header="Checked In" Binding="{Binding LastCheckIn, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="115" />
                    <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="120" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" />

            <!-- Details panel: preview, state, properties, references -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock Margin="18" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                   Text="Select a file to see its preview and details."
                                   Visibility="{Binding Details, Converter={StaticResource NullToVis}}" />
                        <StackPanel Margin="16,16,16,18" DataContext="{Binding Details}"
                                    Visibility="{Binding Converter={StaticResource NotNullToVis}}">
                            <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="240" ClipToBounds="True">
                                <Grid>
                                    <Grid Visibility="{Binding ShowPicture, Converter={StaticResource BoolToVis}}">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="No preview" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                                    </Grid>
                                    <views:ModelViewer Model="{Binding Model}" Margin="1"
                                                       Visibility="{Binding Show3D, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Loading 3D preview&#x2026;" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Loading3D, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasPreviewFile, Converter={StaticResource BoolToVis}}">
                                <ToggleButton DockPanel.Dock="Left" Content="3D view" Padding="12,3" MinHeight="28" IsChecked="{Binding Show3D}" />
                                <Button DockPanel.Dock="Right" Content="Open large 3D view" Padding="12,3" MinHeight="28"
                                        Command="{Binding DataContext.Open3DCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Border />
                            </DockPanel>
                            <TextBlock Text="{Binding PreviewNote}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0"
                                          Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FDECEC" CornerRadius="6" Padding="8,6" Margin="0,2">
                                            <TextBlock Text="{Binding}" Foreground="#991B1B" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Details" />
                            <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource PropertyRowTemplate}" />

                            <StackPanel Visibility="{Binding HasProperties, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Properties" />
                                <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasContains, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Contains" />
                                <ItemsControl ItemsSource="{Binding Contains}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasWhereUsed, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Where used" />
                                <ItemsControl ItemsSource="{Binding WhereUsed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="{Binding IndexNote}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
