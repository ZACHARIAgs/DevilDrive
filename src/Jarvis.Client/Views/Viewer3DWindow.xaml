<Window x:Class="Jarvis.Client.Views.Viewer3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Jarvis.Client.Views"
        Title="3D Preview" Width="960" Height="720" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner" Icon="/Assets/vault.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F6F7F9" Padding="10,6">
            <TextBlock x:Name="HintText" Foreground="#6B7280" TextWrapping="Wrap"
                       Text="Drag to rotate, right-drag to pan, scroll to zoom, double-click the cube to snap to a view. This is a simplified preview; open the file in SolidWorks for exact geometry." />
        </Border>
        <views:ModelViewer x:Name="Viewer" />
    </DockPanel>
</Window>
