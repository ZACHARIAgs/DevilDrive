<Window x:Class="Jarvis.Client.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Jarvis" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="StepStatus" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="18">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Welcome to Jarvis" />
        <TextBlock Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,14"
                   Text="Let's get this PC ready. Your team's SolidWorks files live in a private GitHub repo (the vault); this app checks them out and in for you." />

        <DockPanel Margin="0,6">
            <Button x:Name="GitButton" DockPanel.Dock="Right" Style="{StaticResource StepButton}" Content="Install Git" Click="OnInstallGit" />
            <StackPanel>
                <TextBlock Style="{StaticResource Step}" Text="1. Git and Git LFS" />
                <TextBlock x:Name="GitText" Style="{StaticResource StepStatus}" Text="Checking&#x2026;" />
            </StackPanel>
        </DockPanel>

        <DockPanel Margin="0,10,0,6">
            <Button x:Name="SignInButton" DockPanel.Dock="Right" Style="{StaticResource StepButton}" Content="Sign in to GitHub" Click="OnSignIn" />
            <StackPanel>
                <TextBlock Style="{StaticResource Step}" Text="2. Your GitHub account" />
                <TextBlock x:Name="SignInText" Style="{StaticResource StepStatus}" Text="Checking&#x2026;" />
            </StackPanel>
        </DockPanel>

        <StackPanel Margin="0,10,0,6">
            <TextBlock Style="{StaticResource Step}" Text="3. Your team's vault" />
            <TextBlock Style="{StaticResource StepStatus}"
                       Text="Joining a team? Accept the GitHub invite from your team lead first, then find your vault. Starting a team? Create its vault and invite your teammates." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="FindButton" Content="Find my vaults" Padding="14,4" FontWeight="SemiBold" Click="OnFind" />
                <Button x:Name="NewButton" Content="New team vault&#x2026;" Padding="12,4" Margin="8,0,0,0" Click="OnNew" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource DialogButton}" Content="Skip for now" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
