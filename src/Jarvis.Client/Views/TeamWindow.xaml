<Window x:Class="Jarvis.Client.Views.TeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Team" Width="640" Height="680" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18,10,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SubText" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,12" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Add people -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" x:Name="AddPanel">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Add people" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="Their GitHub usernames, separated by commas or spaces. They get an invitation by email, and can check files out and in once they accept. No GitHub account yet? They make a free one at github.com." />
                <DockPanel>
                    <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Add to team" Margin="8,0,0,0"
                            Padding="16,5" Click="OnAdd" />
                    <TextBox x:Name="UsersBox" Tag="e.g. sam-lee, priya42" KeyDown="OnUsersKeyDown" />
                </DockPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="2,16,2,6">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom" />
            <TextBlock FontWeight="SemiBold" Text="People with access" />
        </DockPanel>

        <!-- Members and pending invitations -->
        <ListBox x:Name="MemberList" Grid.Row="3" Padding="6" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Visibility="{Binding ActionVisibility}"
                                Click="OnMemberAction" Tag="{Binding}" MinHeight="28" Padding="10,2" VerticalAlignment="Center" />
                        <Border Width="36" Height="36" CornerRadius="18" Background="{Binding AvatarBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="12" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" Margin="2,10,2,0" />

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Close" IsCancel="True" />
            <Button x:Name="CopyButton" DockPanel.Dock="Left" Content="Copy welcome message" Click="OnCopy"
                    ToolTip="What new teammates need to do: accept the invite, install Jarvis, find the vault. Paste it into Discord, email or a text." />
            <TextBlock />
        </DockPanel>
    </Grid>
</Window>
