<Window x:Class="Jarvis.Client.Views.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis" Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="28"
                       Foreground="#C62828" Margin="0,0,12,0" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <Expander x:Name="DetailsExpander" Header="Technical details" Margin="0,14,0,0">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource DialogButton}" Content="Copy" Click="OnCopy"
                    ToolTip="Copy the message and details, to paste into Discord when asking for help." />
            <Button Style="{StaticResource DialogButton}" Content="OK" IsDefault="True" IsCancel="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
