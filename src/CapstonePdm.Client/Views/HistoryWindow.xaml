<Window x:Class="CapstonePdm.Client.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History" Width="860" Height="480" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#666" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Close" IsCancel="True" Click="OnClose" />
            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}"
                    Content="Restore This Version&#x2026;" IsEnabled="False" Click="OnRestore"
                    ToolTip="Check the file out, put this version back, and check it in as a new version. Nothing is lost: newer versions stay in the history." />
        </DockPanel>

        <DataGrid x:Name="VersionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEEEEE" SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="60" />
                <DataGridTextColumn Header="Checked In" Binding="{Binding Date.LocalDateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="120" />
                <DataGridTextColumn Header="Checked In By" Binding="{Binding Author}" Width="140" />
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" Width="70" FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
