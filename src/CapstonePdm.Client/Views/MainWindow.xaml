<Window x:Class="CapstonePdm.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="/Assets/vault.ico"
        Height="720" Width="1280" MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Command="{Binding GetLatestCommand}"
                        ToolTip="Download the newest version of every file. Files you've changed are never overwritten.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE896;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Get Latest" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding CheckOutCommand}"
                        ToolTip="Lock the selected files so only you can edit them, and make them writable.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72E;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Check Out" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CheckInCommand}"
                        ToolTip="Save the selected files to the vault as a new version (with nothing selected: everything you can check in).">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE898;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Check In&#x2026;" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding UndoCheckOutCommand}"
                        ToolTip="Throw away your changes to the selected files and release the check-out.">
                    <StackPanel MinWidth="80">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7A7;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Undo Check Out" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding HistoryCommand}" ToolTip="See every version of the selected file and restore an old one.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE81C;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="History&#x2026;" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding MilestonesCommand}" ToolTip="Snapshots of the whole vault (e.g. design reviews): view the vault as it was.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7C1;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Milestones&#x2026;" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ReturnToLatestCommand}" Visibility="{Binding IsViewingMilestone, Converter={StaticResource BoolToVis}}"
                        ToolTip="Leave the milestone and go back to the newest files.">
                    <StackPanel MinWidth="80">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72B;" Foreground="#B45309" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Return to Latest" />
                    </StackPanel>
                </Button>                <Button Command="{Binding RefreshCommand}" ToolTip="Update the list and who has what checked out (F5).">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE72C;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Refresh" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding OpenCommand}" ToolTip="Open the selected file (SolidWorks opens it read-only unless it's checked out to you).">
                    <StackPanel MinWidth="50">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8E5;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Open" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowInExplorerCommand}" ToolTip="Show the selected file in Windows Explorer.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE838;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Explorer" />
                    </StackPanel>
                </Button>
                <Separator Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding BreakLockCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: release someone else's stale check-out.">
                    <StackPanel MinWidth="70">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE711;" Foreground="#C62828" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Break Lock" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RequestCheckInCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: have the person who has this file checked out check in their last saved version automatically.">
                    <StackPanel MinWidth="80">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE715;" Foreground="#334155" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Request Check-In" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding FreezeCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: freeze the selected files (e.g. released for production) so nobody can change them.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xEA18;" Foreground="#334155" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Freeze&#x2026;" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding UnfreezeCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        ToolTip="Admin: make the selected frozen files editable again.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE785;" Foreground="#334155" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Unfreeze" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding SettingsCommand}" ToolTip="Vault folder and your GitHub username.">
                    <StackPanel MinWidth="60">
                        <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" />
                        <TextBlock Style="{StaticResource ToolLabel}" Text="Settings" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Border DockPanel.Dock="Top" Background="{Binding BannerBrush}" Padding="10,6"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" />
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="8,6">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox DockPanel.Dock="Right" Width="210" Margin="8,0,0,0" SelectedIndex="{Binding FilterIndex}">
                <ComboBoxItem Content="All files" />
                <ComboBoxItem Content="Checked out to me" />
                <ComboBoxItem Content="Checked out by others" />
                <ComboBoxItem Content="Needs attention" />
                <ComboBoxItem Content="Newer version in vault" />
                <ComboBoxItem Content="Frozen" />
            </ComboBox>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" />
        </DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <ProgressBar Width="80" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding InfoText}" Foreground="#555" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="310" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="FilesGrid" Grid.Column="0"
                      ItemsSource="{Binding FilesView}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE"
                      RowHeight="24" BorderThickness="0,1,0,0"
                      SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Check Out" Command="{Binding CheckOutCommand}" />
                        <MenuItem Header="Check In&#x2026;" Command="{Binding CheckInCommand}" />
                        <MenuItem Header="Undo Check Out" Command="{Binding UndoCheckOutCommand}" />
                        <Separator />
                        <MenuItem Header="History&#x2026;" Command="{Binding HistoryCommand}" />
                        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <MenuItem Header="Show in Explorer" Command="{Binding ShowInExplorerCommand}" />
                        <Separator Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Break Lock (admin)" Command="{Binding BreakLockCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Request Check-In&#x2026; (admin)" Command="{Binding RequestCheckInCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Freeze&#x2026; (admin)" Command="{Binding FreezeCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                        <MenuItem Header="Unfreeze (admin)" Command="{Binding UnfreezeCommand}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="26" CanUserResize="False" SortMemberPath="StateSort">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StateGlyph}" Foreground="{Binding StateBrush}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="230" />
                    <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="100" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="170" />
                    <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="250" SortMemberPath="StateSort" />
                    <DataGridTextColumn Header="Checked Out By" Binding="{Binding CheckedOutBy}" Width="130" />
                    <DataGridTextColumn Header="Since" Binding="{Binding CheckedOutSince, StringFormat='{}{0:ddd MMM d, h:mm tt}'}" Width="130" />
                    <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" SortMemberPath="Version" Width="60" />
                    <DataGridTextColumn Header="Last Check-In Comment" Binding="{Binding LastComment}" Width="*" MinWidth="180" />
                    <DataGridTextColumn Header="Checked In By" Binding="{Binding LastCheckedInBy}" Width="120" />
                    <DataGridTextColumn Header="Checked In" Binding="{Binding LastCheckIn, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="115" />
                    <DataGridTextColumn Header="Material" Binding="{Binding Material}" Width="120" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEF0F3" />

            <!-- Details panel: preview, state, properties, references -->
            <Border Grid.Column="2" Background="#F6F7F9">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock Margin="16" TextWrapping="Wrap" Foreground="#6B7280"
                                   Text="Select a file to see its preview and details."
                                   Visibility="{Binding Details, Converter={StaticResource NullToVis}}" />
                        <StackPanel Margin="16" DataContext="{Binding Details}"
                                    Visibility="{Binding Converter={StaticResource NotNullToVis}}">
                            <Border Background="White" CornerRadius="8" BorderBrush="#E1E4E9" BorderThickness="1" Height="220">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="No preview" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0"
                                          Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FDECEC" CornerRadius="6" Padding="8,6" Margin="0,2">
                                            <TextBlock Text="{Binding}" Foreground="#991B1B" TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Details" />
                            <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource PropertyRowTemplate}" />

                            <StackPanel Visibility="{Binding HasProperties, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Properties" />
                                <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource PropertyRowTemplate}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasContains, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Contains" />
                                <ItemsControl ItemsSource="{Binding Contains}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasWhereUsed, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Where used" />
                                <ItemsControl ItemsSource="{Binding WhereUsed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="{Binding IndexNote}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
