<Window x:Class="CapstonePdm.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock FontWeight="SemiBold" Text="Vault folder" />
        <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,4"
                   Text="Everyone must use the same folder (C:\CapstoneVault) or assembly references will break." />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse&#x2026;" Padding="10,2" Margin="6,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="VaultPathBox" Height="24" VerticalContentAlignment="Center" />
        </DockPanel>

        <TextBlock FontWeight="SemiBold" Text="Signed in to GitHub as" Margin="0,14,0,0" />
        <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,4"
                   Text="Checked with GitHub using your saved sign-in, so it can't be changed here. Admin rights come from this account." />
        <TextBlock x:Name="SignedInText" TextWrapping="Wrap" />

        <CheckBox x:Name="ExplorerMenuBox" Margin="0,16,0,0" Content="Show Capstone PDM in File Explorer's right-click menu (Windows 11: under &quot;Show more options&quot;)" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource DialogButton}" Content="Save" IsDefault="True" Click="OnSave" />
            <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
