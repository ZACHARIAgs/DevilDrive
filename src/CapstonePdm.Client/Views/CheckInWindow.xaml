<Window x:Class="CapstonePdm.Client.Views.CheckInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check In" Width="540" Height="460" MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="FilesHeader" FontWeight="SemiBold" Text="Files:" />
        <ListBox x:Name="FileList" Grid.Row="1" Margin="0,4,0,10" />

        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Comment (required): what changed and why" />
        <TextBox x:Name="CommentBox" Grid.Row="3" Height="90" Margin="0,4,0,8"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 TextChanged="OnCommentChanged" />

        <CheckBox x:Name="KeepCheckedOutBox" Grid.Row="4"
                  Content="Keep checked out (save a version now and keep editing)" />

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#666"
                       Text="Close the files in SolidWorks first." />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}"
                    Content="Check In" IsEnabled="False" Click="OnOk" />
        </DockPanel>
    </Grid>
</Window>
