<Window x:Class="CapstonePdm.Client.Views.NewVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New team vault" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" Foreground="#555"
                   Text="Creates a private GitHub repo for your team's SolidWorks files, with check-out locking and the vault guard set up, and downloads it to this PC. Afterwards you invite your teammates." />

        <TextBlock FontWeight="SemiBold" Text="Vault name" Margin="0,14,0,0" />
        <TextBox x:Name="NameBox" Height="24" Margin="0,4,0,0" VerticalContentAlignment="Center" TextChanged="OnNameChanged" />

        <TextBlock FontWeight="SemiBold" Text="GitHub owner" Margin="0,12,0,0" />
        <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,4"
                   Text="Your account, or an organization you can create repos in. With an organization, several people can be vault admins." />
        <ComboBox x:Name="OwnerBox" IsEditable="True" Height="24" />

        <TextBlock FontWeight="SemiBold" Text="Repo name on GitHub" Margin="0,12,0,0" />
        <TextBox x:Name="RepoBox" Height="24" Margin="0,4,0,0" VerticalContentAlignment="Center" TextChanged="OnRepoChanged" />

        <TextBlock FontWeight="SemiBold" Text="SolidWorks version everyone saves in" Margin="0,12,0,0" />
        <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,4"
                   Text="Use the oldest version anyone on the team has: files saved in a newer version can't be opened in an older one." />
        <ComboBox x:Name="VersionBox" IsEditable="True" Height="24" Width="140" HorizontalAlignment="Left" />

        <TextBlock FontWeight="SemiBold" Text="Vault folder" Margin="0,12,0,0" />
        <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,4"
                   Text="Every teammate gets the vault in this same folder, so assemblies find their parts. Keep it short and outside OneDrive." />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse&#x2026;" Padding="10,2" Margin="6,0,0,0" Click="OnBrowse" />
            <TextBox x:Name="FolderBox" Height="24" VerticalContentAlignment="Center" TextChanged="OnFolderChanged" />
        </DockPanel>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#555" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CreateButton" Style="{StaticResource DialogButton}" Content="Create vault" IsDefault="True" Click="OnCreate" />
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
