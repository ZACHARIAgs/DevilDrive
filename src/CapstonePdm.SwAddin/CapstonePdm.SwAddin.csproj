<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SolidWorks add-in. SolidWorks loads add-ins in-process on .NET Framework, hence net48.

    Built against the SolidWorks 2024 interop files. Interop types are embedded (no dependency
    on a specific SolidWorks.Interop version at runtime), and only API calls that exist in 2024
    are used, so one build works in SolidWorks 2024 and newer.

    Building needs SolidWorks installed. Override the folder with /p:SolidWorksDir=... if needed.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>CapstonePdm.SwAddin</RootNamespace>
    <AssemblyName>CapstonePdm.SwAddin</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SolidWorksDir Condition="'$(SolidWorksDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\</SolidWorksDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksDir)SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksDir)SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksDir)SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\vault.png" LogicalName="CapstonePdm.SwAddin.vault.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CapstonePdm.Core\CapstonePdm.Core.csproj" />
  </ItemGroup>

</Project>
