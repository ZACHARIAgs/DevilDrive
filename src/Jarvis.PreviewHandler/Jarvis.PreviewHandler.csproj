<Project Sdk="Microsoft.NET.Sdk">

  <!--
    File Explorer preview pane: shows a vault part's or assembly's 3D preview you can rotate.
    Windows loads preview handlers in its preview host process (prevhost.exe), which needs an
    in-process COM server, hence .NET Framework 4.8. The desktop app embeds the output and registers
    it for the current user (no admin rights). It deliberately doesn't use Jarvis.Core (whose
    System.Text.Json dependencies would need binding redirects inside prevhost); the two files it
    needs are linked instead.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Jarvis.PreviewHandler</RootNamespace>
    <AssemblyName>Jarvis.PreviewHandler</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="2.25.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Jarvis.Core\Preview\PreviewMesh.cs" Link="Shared\PreviewMesh.cs" />
    <Compile Include="..\Jarvis.Client\Services\PreviewModel.cs" Link="Shared\PreviewModel.cs" />
  </ItemGroup>

</Project>
