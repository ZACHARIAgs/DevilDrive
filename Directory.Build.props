<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Product>DevilDrive</Product>
    <Company>Solar Devils (ASU)</Company>
    <Version>0.7.7</Version>
    <!-- GitHub repo (owner/name) whose Releases the app updates itself from. Baked into the build on purpose:
         a setting in the vault could be changed to point everyone at a different exe. Change it for a fork (e.g. a club). -->
    <UpdateRepo>ZACHARIAgs/DevilDrive</UpdateRepo>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>
</Project>
