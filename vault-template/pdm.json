{
  // Shared Jarvis settings. Admins edit this file and check it in like any other file.
  "vaultName": "Team Vault",
  "branch": "main",

  // The folder every member keeps this vault in. Assembly references are full paths, so it must be
  // the same on every PC. Used when someone adds this vault with "Vaults..." in the app.
  "localPath": "C:\\TeamVault",

  // The SolidWorks version everyone saves vault files in. Files saved in a newer version can't be
  // opened in an older one, so the add-in blocks check-ins of newer files. Use null for no check.
  "solidWorksVersion": 2024,

  // Storage meter (admins): GitHub's free Git LFS storage, and when to warn.
  "storageLimitGB": 10,
  "storageWarningPercent": 70,

  // Ask before checking in files that look like exports (STEP, PDF, DXF...), since every check-in is kept forever.
  "warnOnExports": true,

  // Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
  "discordWebhookUrl": "",

  // Admins are whoever GitHub lists as Admin or Maintain on this repo (not set here, so nobody can
  // make themselves admin). For several admins, keep the vault in a free GitHub organization.

  // GitHub username -> name shown in the vault view and in Discord.
  // Anyone not listed here is shown by their GitHub username.
  "team": {
  },

  "notify": {
    "checkOut": true,
    "checkIn": true,
    "undoCheckOut": true,
    "breakLock": true
  }
}
